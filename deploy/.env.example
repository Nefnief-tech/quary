# Copy to deploy/.env (`make dev` generates it with a random password if
# missing). Values here are local-dev only — never commit real credentials.

POSTGRES_DB=quarry
POSTGRES_USER=quarry
# Required. Generate with: head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'
POSTGRES_PASSWORD=

# Enrollment token for the dev daemon. Leave empty after the daemon has
# enrolled once; create a node via the API to mint one:
#   POST /api/v1/nodes {"name": "local-dev"}
QUARRY_ENROLLMENT_TOKEN=

# Host UID/GID the daemon (and sibling Minecraft containers) run as.
# `make dev` fills these from `id -u` / `id -g` automatically.
QUARRY_DOCKER_UID=1000
QUARRY_DOCKER_GID=1000
# GID of the host's docker socket group (stat -c %g /var/run/docker.sock).
QUARRY_DOCKER_SOCK_GID=999
