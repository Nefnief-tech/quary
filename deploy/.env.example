# Quarry configuration — copy to deploy/.env and fill in.
# The guided installer (install.sh) generates this file for you.
# Never commit real credentials.

# --- database (use your own random password!) ---
POSTGRES_DB=quarry
POSTGRES_USER=quarry
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- ports / addressing (production compose) ---
QUARRY_PANEL_PORT=8080
QUARRY_ROUTER_PORT=25565
QUARRY_PUBLIC_HOST=localhost
QUARRY_NODE_NAME=main

# --- docker socket access (id -u / id -g / stat -c %g /var/run/docker.sock) ---
QUARRY_DOCKER_UID=1000
QUARRY_DOCKER_GID=1000
QUARRY_DOCKER_SOCK_GID=999

# --- absolute host paths (must stay identical inside the daemon container) ---
QUARRY_HOST_SERVERS_DIR=/opt/quarry/data/servers
QUARRY_HOST_DAEMON_DIR=/opt/quarry/data/daemon

# --- dev compose only ---
# Enrollment token for the dev daemon. Leave empty after the daemon has
# enrolled once; create a node via the API to mint one:
#   POST /api/v1/nodes {"name": "local-dev"}
QUARRY_ENROLLMENT_TOKEN=
